<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <!--
  No Terminal.Gui / NATS.Client package references here by design - this assembly holds the
  framework-independent, unit-testable core (currently: Payloads/, AsyncExtensions' pure-Rx half)
  shared across UI tabs, so it can be exercised by lazynats.Core.Tests without constructing UI or
  network state. System.Reactive is the one exception to "no package references": Rx itself is
  generic, not a UI or NATS dependency - only the Terminal.Gui-IApplication-dispatching half of
  AsyncExtensions stays in the app project.
  -->

  <ItemGroup>
    <PackageReference Include="System.Reactive" Version="7.0.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="lazynats" />
    <InternalsVisibleTo Include="lazynats.Core.Tests" />
  </ItemGroup>

</Project>
